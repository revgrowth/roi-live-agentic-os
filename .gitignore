# Secrets
.env
.mcp.json
**/.env.local

# Local settings (per-machine Claude permissions)
.claude/settings.local.json
.claude/hooks_info/ccnotify.db
.claude/hooks_info/ccnotify.log*

# Installer state
.claude/skills/_catalog/installed.json

# Dev-only skills (not shipped to main)
.claude/skills/ops-new-feature/
.claude/skills/ops-release/

# System
.DS_Store
.backup/
.tmp/

# Next.js / Node (inside project folders)
**/node_modules/
**/.next/
**/next-env.d.ts
**/tsconfig.tsbuildinfo

# Command Centre data (inside project folders)
**/.command-centre/

# Agent worktrees (temporary, per-machine)
.worktrees/
.claude/worktrees/

# SQLite databases (inside project folders)
**/data.db

# Cron runtime (logs and status are generated at runtime)
cron/logs/
cron/status/
__pycache__/
*.pyc
context/memory/*.md
clients/*/context/memory/*.md
__pycache__/
*.pyc

# Runtime files that mutate every session
**/.claude/hooks_info/ccnotify.db
**/.claude/hooks_info/ccnotify.log
**/.claude/settings.local.json


# Runtime hook logs - exclude rotated ccnotify logs
clients/*/.claude/hooks_info/ccnotify.log.*
.claude/hooks_info/ccnotify.log.*

# Obsidian
.obsidian/
.trash/
# Auto-backup log
scripts/auto-backup.log

# Jev dispatcher runtime. The build must not create ENABLED.on.
clients/roi-live/projects/jev-dispatcher-2026-09/ENABLED.on
clients/roi-live/projects/jev-dispatcher-2026-09/ENABLED.off
clients/roi-live/projects/jev-dispatcher-2026-09/ENABLED.on.killed
clients/roi-live/projects/jev-dispatcher-2026-09/KILL
clients/roi-live/projects/jev-dispatcher-2026-09/queues/
clients/roi-live/projects/jev-dispatcher-2026-09/out/
clients/roi-live/projects/jev-dispatcher-2026-09/eval-run/
clients/roi-live/projects/jev-dispatcher-2026-09/seat-capacity.json
